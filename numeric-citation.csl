<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="zh-CN">
  <info>
    <title>Thesis numeric citation order</title>
    <id>http://example.org/styles/thesis-numeric-order</id>
    <link href="http://example.org/styles/thesis-numeric-order" rel="self"/>
    <updated>2026-10-09T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="zh-CN"><terms>
    <term name="et-al">et al.</term>
    <term name="page-range-delimiter">-</term>
  </terms></locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=" " delimiter=", "/>
      <et-al/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="issued"><date variable="issued"><date-part name="year"/></date></macro>
  <macro name="publisher"><group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group></macro>
  <macro name="edition"><choose><if is-numeric="edition"><text variable="edition" suffix=" 版"/></if><else><text variable="edition"/></else></choose></macro>
  <citation collapse="citation-number" after-collapse-delimiter=",">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=","><text variable="citation-number"/></layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="3" second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort><key variable="citation-number"/></sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="author" suffix=". "/><text variable="title"/>
      <choose>
        <if type="book">
          <text value="[M]. "/><text macro="edition" suffix=". "/>
          <text macro="publisher" suffix=", "/><text macro="issued"/>
        </if>
        <else-if type="paper-conference">
          <text value="[C]//"/><text variable="container-title" suffix=". "/>
          <text macro="publisher" suffix=", "/><text macro="issued"/><text variable="page" prefix=": "/>
        </else-if>
        <else>
          <text value="[J]. "/><text variable="container-title" suffix=", "/><text macro="issued"/>
          <group prefix=", "><text variable="volume"/><text variable="issue" prefix="(" suffix=")"/></group>
          <text variable="page" prefix=": "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
